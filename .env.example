# Supabase Configuration
# Get these values from: https://app.supabase.com → Your Project → Settings → API

# Project URL (e.g., https://abcdefghijklmnop.supabase.co)
VITE_SUPABASE_URL=your_supabase_url_here

# Anon/Public Key (starts with "eyJ...")
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OAuth redirect URL — set to http://localhost:5173 for local dev, https://app.kluvs.com for production
VITE_OAUTH_REDIRECT_URL=your_oauth_redirect_url_here
