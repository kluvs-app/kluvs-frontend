{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots-allow.txt",
      "has": [{ "type": "host", "value": { "inc": ["kluvs.com", "www.kluvs.com"] } }]
    },
    { "source": "/robots.txt", "destination": "/robots-disallow.txt" },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "has": [{ "type": "host", "value": "app\\.kluvs\\.(com|xyz)" }]
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
